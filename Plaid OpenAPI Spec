openapi: 3.0.3
info:
  title: Plaid API
  version: "2020-09-14"
  description: |
    The Plaid API provides programmatic access to financial data and services.
    All requests are POST with JSON bodies. Authentication is via `client_id` and `secret`,
    supplied either in the request body or via `PLAID-CLIENT-ID` and `PLAID-SECRET` headers.
    Every response includes a `request_id` for troubleshooting.

    **Environments:**
    - Sandbox: `https://sandbox.plaid.com`
    - Production: `https://production.plaid.com`
  contact:
    name: Plaid Developer Support
    url: https://plaid.com/docs/
  license:
    name: Plaid API Terms of Service
    url: https://plaid.com/legal/

servers:
  - url: https://sandbox.plaid.com
    description: Sandbox (test environment)
  - url: https://production.plaid.com
    description: Production

security:
  - PlaidClientId: []
    PlaidSecret: []

tags:
  - name: Link
    description: Generate Link tokens to initialize Plaid Link
  - name: Items
    description: Manage Items (connections to financial institutions)
  - name: Accounts
    description: Retrieve account data
  - name: Transactions
    description: Retrieve and sync transaction history
  - name: Auth
    description: Retrieve bank account and routing numbers
  - name: Identity
    description: Retrieve identity and owner information
  - name: Institutions
    description: Search and retrieve institution metadata
  - name: Sandbox
    description: Sandbox-only endpoints for testing

# ─────────────────────────────────────────────────────────
# PATHS
# ─────────────────────────────────────────────────────────
paths:

  # ── LINK ─────────────────────────────────────────────
  /link/token/create:
    post:
      tags: [Link]
      operationId: linkTokenCreate
      summary: Create a Link token
      description: |
        Creates a `link_token`, a short-lived token used to initialize Plaid Link.
        The token expires after 4 hours. Pass the token to the Plaid Link client-side SDK.
      requestBody:
        required: true
        content:
          application/json:
            schema:
              $ref: '#/components/schemas/LinkTokenCreateRequest'
      responses:
        '200':
          description: Link token created successfully
          content:
            application/json:
              schema:
                $ref: '#/components/schemas/LinkTokenCreateResponse'
        default:
          $ref: '#/components/responses/PlaidError'

  /link/token/get:
    post:
      tags: [Link]
      operationId: linkTokenGet
      summary: Get a Link token
      description: Retrieve metadata about a previously created `link_token`.
      requestBody:
        required: true
        content:
          application/json:
            schema:
              allOf:
                - $ref: '#/components/schemas/AuthFields'
                - type: object
                  required: [link_token]
                  properties:
                    link_token:
                      type: string
                      description: The `link_token` to retrieve.
      responses:
        '200':
          description: Link token metadata
          content:
            application/json:
              schema:
                $ref: '#/components/schemas/LinkTokenGetResponse'
        default:
          $ref: '#/components/responses/PlaidError'

  # ── ITEMS ─────────────────────────────────────────────
  /item/get:
    post:
      tags: [Items]
      operationId: itemGet
      summary: Retrieve an Item
      description: Returns metadata and status about an Item.
      requestBody:
        required: true
        content:
          application/json:
            schema:
              allOf:
                - $ref: '#/components/schemas/AuthFields'
                - $ref: '#/components/schemas/AccessTokenField'
      responses:
        '200':
          description: Item data
          content:
            application/json:
              schema:
                $ref: '#/components/schemas/ItemGetResponse'
        default:
          $ref: '#/components/responses/PlaidError'

  /item/remove:
    post:
      tags: [Items]
      operationId: itemRemove
      summary: Remove an Item
      description: |
        Removes an Item. Access tokens associated with the Item are invalidated.
        The Item is not recoverable once removed.
      requestBody:
        required: true
        content:
          application/json:
            schema:
              allOf:
                - $ref: '#/components/schemas/AuthFields'
                - $ref: '#/components/schemas/AccessTokenField'
      responses:
        '200':
          description: Item removed successfully
          content:
            application/json:
              schema:
                $ref: '#/components/schemas/ItemRemoveResponse'
        default:
          $ref: '#/components/responses/PlaidError'

  /item/webhook/update:
    post:
      tags: [Items]
      operationId: itemWebhookUpdate
      summary: Update a webhook URL
      description: Updates the webhook URL for an Item. The new URL must be HTTPS.
      requestBody:
        required: true
        content:
          application/json:
            schema:
              allOf:
                - $ref: '#/components/schemas/AuthFields'
                - $ref: '#/components/schemas/AccessTokenField'
                - type: object
                  required: [webhook]
                  properties:
                    webhook:
                      type: string
                      format: uri
                      description: The new webhook URL to associate with the Item.
      responses:
        '200':
          description: Webhook URL updated
          content:
            application/json:
              schema:
                $ref: '#/components/schemas/ItemWebhookUpdateResponse'
        default:
          $ref: '#/components/responses/PlaidError'

  /item/public_token/exchange:
    post:
      tags: [Items]
      operationId: itemPublicTokenExchange
      summary: Exchange a public token for an access token
      description: |
        Exchange the short-lived `public_token` returned by Plaid Link for a long-lived
        `access_token`. The `access_token` is required for all subsequent API calls on
        that Item.
      requestBody:
        required: true
        content:
          application/json:
            schema:
              allOf:
                - $ref: '#/components/schemas/AuthFields'
                - type: object
                  required: [public_token]
                  properties:
                    public_token:
                      type: string
                      description: The `public_token` returned from Plaid Link's `onSuccess` callback.
      responses:
        '200':
          description: Access token issued
          content:
            application/json:
              schema:
                $ref: '#/components/schemas/ItemPublicTokenExchangeResponse'
        default:
          $ref: '#/components/responses/PlaidError'

  /item/access_token/invalidate:
    post:
      tags: [Items]
      operationId: itemAccessTokenInvalidate
      summary: Rotate an access token
      description: |
        Rotates the access token associated with an Item. Returns a new access token;
        the old token is immediately invalidated. The Item itself is not deleted.
      requestBody:
        required: true
        content:
          application/json:
            schema:
              allOf:
                - $ref: '#/components/schemas/AuthFields'
                - $ref: '#/components/schemas/AccessTokenField'
      responses:
        '200':
          description: New access token
          content:
            application/json:
              schema:
                type: object
                properties:
                  new_access_token:
                    type: string
                    description: The newly rotated access token.
                  request_id:
                    $ref: '#/components/schemas/RequestId'
        default:
          $ref: '#/components/responses/PlaidError'

  # ── ACCOUNTS ──────────────────────────────────────────
  /accounts/get:
    post:
      tags: [Accounts]
      operationId: accountsGet
      summary: Retrieve accounts
      description: Returns account metadata for all accounts linked to an Item.
      requestBody:
        required: true
        content:
          application/json:
            schema:
              allOf:
                - $ref: '#/components/schemas/AuthFields'
                - $ref: '#/components/schemas/AccessTokenField'
                - type: object
                  properties:
                    options:
                      type: object
                      properties:
                        account_ids:
                          type: array
                          items:
                            type: string
                          description: Filter results to specific account IDs.
      responses:
        '200':
          description: Account list
          content:
            application/json:
              schema:
                $ref: '#/components/schemas/AccountsGetResponse'
        default:
          $ref: '#/components/responses/PlaidError'

  /accounts/balance/get:
    post:
      tags: [Accounts]
      operationId: accountsBalanceGet
      summary: Retrieve real-time balances
      description: |
        Returns real-time balance data for each of an Item's accounts.
        Balance data is fetched live from the institution; this call may be slow.
      requestBody:
        required: true
        content:
          application/json:
            schema:
              allOf:
                - $ref: '#/components/schemas/AuthFields'
                - $ref: '#/components/schemas/AccessTokenField'
                - type: object
                  properties:
                    options:
                      type: object
                      properties:
                        account_ids:
                          type: array
                          items:
                            type: string
                          description: Filter to specific account IDs.
                        min_last_updated_datetime:
                          type: string
                          format: date-time
                          description: |
                            Returns an error if cached balance data is older than this timestamp.
      responses:
        '200':
          description: Real-time balances
          content:
            application/json:
              schema:
                $ref: '#/components/schemas/AccountsGetResponse'
        default:
          $ref: '#/components/responses/PlaidError'

  # ── TRANSACTIONS ──────────────────────────────────────
  /transactions/sync:
    post:
      tags: [Transactions]
      operationId: transactionsSync
      summary: Sync incremental transaction updates
      description: |
        Retrieves added, modified, and removed transactions using a cursor for
        incremental updates. Omit `cursor` on first call to get full history.
        Supported account types: `credit`, `depository`, and `student` loan.
      requestBody:
        required: true
        content:
          application/json:
            schema:
              $ref: '#/components/schemas/TransactionsSyncRequest'
      responses:
        '200':
          description: Incremental transaction updates
          content:
            application/json:
              schema:
                $ref: '#/components/schemas/TransactionsSyncResponse'
        default:
          $ref: '#/components/responses/PlaidError'

  /transactions/get:
    post:
      tags: [Transactions]
      operationId: transactionsGet
      summary: Fetch transactions by date range
      description: |
        Returns transactions for an Item within a date range (up to 24 months).
        Results are paginated. Prefer `/transactions/sync` for new integrations.
      requestBody:
        required: true
        content:
          application/json:
            schema:
              $ref: '#/components/schemas/TransactionsGetRequest'
      responses:
        '200':
          description: Transaction list
          content:
            application/json:
              schema:
                $ref: '#/components/schemas/TransactionsGetResponse'
        default:
          $ref: '#/components/responses/PlaidError'

  /transactions/refresh:
    post:
      tags: [Transactions]
      operationId: transactionsRefresh
      summary: Force a transaction refresh
      description: |
        Requests an immediate refresh of transaction data from the institution.
        Fires a `SYNC_UPDATES_AVAILABLE` webhook when new data is ready.
      requestBody:
        required: true
        content:
          application/json:
            schema:
              allOf:
                - $ref: '#/components/schemas/AuthFields'
                - $ref: '#/components/schemas/AccessTokenField'
      responses:
        '200':
          description: Refresh initiated
          content:
            application/json:
              schema:
                type: object
                properties:
                  request_id:
                    $ref: '#/components/schemas/RequestId'
        default:
          $ref: '#/components/responses/PlaidError'

  /transactions/recurring/get:
    post:
      tags: [Transactions]
      operationId: transactionsRecurringGet
      summary: Fetch recurring transaction streams
      description: |
        Returns recurring transaction streams (e.g. subscriptions, salary, rent)
        identified from the Item's transaction history.
      requestBody:
        required: true
        content:
          application/json:
            schema:
              allOf:
                - $ref: '#/components/schemas/AuthFields'
                - $ref: '#/components/schemas/AccessTokenField'
                - type: object
                  properties:
                    account_ids:
                      type: array
                      items:
                        type: string
                      description: Filter to specific account IDs.
                    options:
                      type: object
                      properties:
                        include_personal_finance_category:
                          type: boolean
                          default: false
      responses:
        '200':
          description: Recurring transaction streams
          content:
            application/json:
              schema:
                $ref: '#/components/schemas/TransactionsRecurringGetResponse'
        default:
          $ref: '#/components/responses/PlaidError'

  /categories/get:
    post:
      tags: [Transactions]
      operationId: categoriesGet
      summary: Fetch all transaction categories
      description: Returns the full Plaid transaction category taxonomy. No auth required.
      requestBody:
        required: true
        content:
          application/json:
            schema:
              type: object
              description: Empty request body.
      responses:
        '200':
          description: Category list
          content:
            application/json:
              schema:
                type: object
                properties:
                  categories:
                    type: array
                    items:
                      $ref: '#/components/schemas/Category'
                  request_id:
                    $ref: '#/components/schemas/RequestId'
        default:
          $ref: '#/components/responses/PlaidError'

  # ── AUTH ──────────────────────────────────────────────
  /auth/get:
    post:
      tags: [Auth]
      operationId: authGet
      summary: Retrieve bank account and routing numbers
      description: |
        Returns ACH or EFT account and routing numbers for checking and savings accounts.
        Requires the `auth` product to be enabled on the Item.
      requestBody:
        required: true
        content:
          application/json:
            schema:
              allOf:
                - $ref: '#/components/schemas/AuthFields'
                - $ref: '#/components/schemas/AccessTokenField'
                - type: object
                  properties:
                    options:
                      type: object
                      properties:
                        account_ids:
                          type: array
                          items:
                            type: string
      responses:
        '200':
          description: Account and routing numbers
          content:
            application/json:
              schema:
                $ref: '#/components/schemas/AuthGetResponse'
        default:
          $ref: '#/components/responses/PlaidError'

  # ── IDENTITY ──────────────────────────────────────────
  /identity/get:
    post:
      tags: [Identity]
      operationId: identityGet
      summary: Retrieve identity data
      description: |
        Returns the legal names, phone numbers, email addresses, and mailing addresses
        on file at the financial institution for account owners.
      requestBody:
        required: true
        content:
          application/json:
            schema:
              allOf:
                - $ref: '#/components/schemas/AuthFields'
                - $ref: '#/components/schemas/AccessTokenField'
                - type: object
                  properties:
                    options:
                      type: object
                      properties:
                        account_ids:
                          type: array
                          items:
                            type: string
      responses:
        '200':
          description: Identity data
          content:
            application/json:
              schema:
                $ref: '#/components/schemas/IdentityGetResponse'
        default:
          $ref: '#/components/responses/PlaidError'

  # ── INSTITUTIONS ──────────────────────────────────────
  /institutions/get:
    post:
      tags: [Institutions]
      operationId: institutionsGet
      summary: List institutions
      description: Returns a paginated list of all financial institutions supported by Plaid.
      requestBody:
        required: true
        content:
          application/json:
            schema:
              allOf:
                - $ref: '#/components/schemas/AuthFields'
                - type: object
                  required: [count, offset, country_codes]
                  properties:
                    count:
                      type: integer
                      minimum: 1
                      maximum: 500
                      description: Number of institutions to return.
                    offset:
                      type: integer
                      minimum: 0
                      description: Offset for pagination.
                    country_codes:
                      type: array
                      items:
                        $ref: '#/components/schemas/CountryCode'
                    options:
                      $ref: '#/components/schemas/InstitutionsGetRequestOptions'
      responses:
        '200':
          description: Institution list
          content:
            application/json:
              schema:
                $ref: '#/components/schemas/InstitutionsGetResponse'
        default:
          $ref: '#/components/responses/PlaidError'

  /institutions/search:
    post:
      tags: [Institutions]
      operationId: institutionsSearch
      summary: Search institutions
      description: Returns institutions matching a query string, optionally filtered by products and country.
      requestBody:
        required: true
        content:
          application/json:
            schema:
              allOf:
                - $ref: '#/components/schemas/AuthFields'
                - type: object
                  required: [query, country_codes]
                  properties:
                    query:
                      type: string
                      description: The search query string.
                    products:
                      type: array
                      items:
                        $ref: '#/components/schemas/Products'
                      description: Filter to institutions supporting specific products.
                    country_codes:
                      type: array
                      items:
                        $ref: '#/components/schemas/CountryCode'
                    options:
                      $ref: '#/components/schemas/InstitutionsGetRequestOptions'
      responses:
        '200':
          description: Matching institutions
          content:
            application/json:
              schema:
                $ref: '#/components/schemas/InstitutionsSearchResponse'
        default:
          $ref: '#/components/responses/PlaidError'

  /institutions/get_by_id:
    post:
      tags: [Institutions]
      operationId: institutionsGetById
      summary: Get an institution by ID
      description: Returns detailed metadata for a single institution.
      requestBody:
        required: true
        content:
          application/json:
            schema:
              allOf:
                - $ref: '#/components/schemas/AuthFields'
                - type: object
                  required: [institution_id, country_codes]
                  properties:
                    institution_id:
                      type: string
                      description: The institution's unique Plaid ID (e.g. `ins_3`).
                    country_codes:
                      type: array
                      items:
                        $ref: '#/components/schemas/CountryCode'
                    options:
                      $ref: '#/components/schemas/InstitutionsGetRequestOptions'
      responses:
        '200':
          description: Institution data
          content:
            application/json:
              schema:
                $ref: '#/components/schemas/InstitutionsGetByIdResponse'
        default:
          $ref: '#/components/responses/PlaidError'

  # ── SANDBOX ───────────────────────────────────────────
  /sandbox/public_token/create:
    post:
      tags: [Sandbox]
      operationId: sandboxPublicTokenCreate
      summary: Create a test Item (Sandbox only)
      description: |
        Creates a `public_token` for a test Sandbox Item without going through Plaid Link.
        Useful for automated testing.
      requestBody:
        required: true
        content:
          application/json:
            schema:
              allOf:
                - $ref: '#/components/schemas/AuthFields'
                - type: object
                  required: [institution_id, initial_products]
                  properties:
                    institution_id:
                      type: string
                      description: The Sandbox institution ID (e.g. `ins_109508`).
                    initial_products:
                      type: array
                      items:
                        $ref: '#/components/schemas/Products'
                    options:
                      type: object
                      properties:
                        webhook:
                          type: string
                          format: uri
                        override_username:
                          type: string
                          default: user_good
                        override_password:
                          type: string
                          default: pass_good
                        transactions:
                          type: object
                          properties:
                            start_date:
                              type: string
                              format: date
                            end_date:
                              type: string
                              format: date
      responses:
        '200':
          description: Sandbox public token created
          content:
            application/json:
              schema:
                type: object
                properties:
                  public_token:
                    type: string
                  request_id:
                    $ref: '#/components/schemas/RequestId'
        default:
          $ref: '#/components/responses/PlaidError'

  /sandbox/item/reset_login:
    post:
      tags: [Sandbox]
      operationId: sandboxItemResetLogin
      summary: Force Item into an error state (Sandbox only)
      description: |
        Resets the login for a Sandbox Item to force it into an `ITEM_LOGIN_REQUIRED`
        error state for testing re-authentication flows.
      requestBody:
        required: true
        content:
          application/json:
            schema:
              allOf:
                - $ref: '#/components/schemas/AuthFields'
                - $ref: '#/components/schemas/AccessTokenField'
      responses:
        '200':
          description: Login reset
          content:
            application/json:
              schema:
                type: object
                properties:
                  reset_login:
                    type: boolean
                  request_id:
                    $ref: '#/components/schemas/RequestId'
        default:
          $ref: '#/components/responses/PlaidError'

  /sandbox/item/fire_webhook:
    post:
      tags: [Sandbox]
      operationId: sandboxItemFireWebhook
      summary: Fire a test webhook (Sandbox only)
      description: Manually fires a test webhook for a Sandbox Item.
      requestBody:
        required: true
        content:
          application/json:
            schema:
              allOf:
                - $ref: '#/components/schemas/AuthFields'
                - $ref: '#/components/schemas/AccessTokenField'
                - type: object
                  required: [webhook_code]
                  properties:
                    webhook_code:
                      type: string
                      enum:
                        - DEFAULT_UPDATE
                        - NEW_ACCOUNTS_AVAILABLE
                        - HISTORICAL_UPDATE
                        - INITIAL_UPDATE
                        - SYNC_UPDATES_AVAILABLE
                      description: The webhook event to fire.
      responses:
        '200':
          description: Webhook fired
          content:
            application/json:
              schema:
                type: object
                properties:
                  webhook_fired:
                    type: boolean
                  request_id:
                    $ref: '#/components/schemas/RequestId'
        default:
          $ref: '#/components/responses/PlaidError'

# ─────────────────────────────────────────────────────────
# COMPONENTS
# ─────────────────────────────────────────────────────────
components:

  securitySchemes:
    PlaidClientId:
      type: apiKey
      in: header
      name: PLAID-CLIENT-ID
      description: Your Plaid `client_id`. Also accepted in the request body.
    PlaidSecret:
      type: apiKey
      in: header
      name: PLAID-SECRET
      description: Your Plaid `secret`. Also accepted in the request body.

  responses:
    PlaidError:
      description: Plaid API error
      content:
        application/json:
          schema:
            $ref: '#/components/schemas/PlaidError'

  schemas:

    # ── COMMON FIELDS ─────────────────────────────────
    AuthFields:
      type: object
      properties:
        client_id:
          type: string
          description: Your Plaid API `client_id`. May also be sent as the `PLAID-CLIENT-ID` header.
        secret:
          type: string
          description: Your Plaid API `secret`. May also be sent as the `PLAID-SECRET` header.

    AccessTokenField:
      type: object
      required: [access_token]
      properties:
        access_token:
          type: string
          description: The access token associated with the Item.

    RequestId:
      type: string
      description: A unique ID for the request, useful for troubleshooting with Plaid support.

    # ── ERRORS ────────────────────────────────────────
    PlaidError:
      type: object
      properties:
        error_type:
          type: string
          description: Broad error category.
          enum:
            - INVALID_REQUEST
            - INVALID_RESULT
            - INVALID_INPUT
            - INSTITUTION_ERROR
            - RATE_LIMIT_EXCEEDED
            - API_ERROR
            - ITEM_ERROR
            - ASSET_REPORT_ERROR
            - RECAPTCHA_ERROR
            - OAUTH_ERROR
            - PAYMENT_ERROR
            - BANK_TRANSFER_ERROR
            - INCOME_VERIFICATION_ERROR
            - MICRODEPOSITS_ERROR
            - SANDBOX_ERROR
            - PARTNER_ERROR
            - SIGNAL_ERROR
            - TRANSACTIONS_ERROR
            - TRANSFER_ERROR
            - CHECK_REPORT_ERROR
            - CONSUMER_REPORT_ERROR
            - USER_ERROR
        error_code:
          type: string
          description: The specific error code. Safe for programmatic use.
        error_code_reason:
          type: string
          nullable: true
          description: Additional reason for OAuth-related errors.
        error_message:
          type: string
          description: Developer-friendly error description. Not safe for programmatic use.
        display_message:
          type: string
          nullable: true
          description: User-facing error message, or null if not user-actionable.
        request_id:
          $ref: '#/components/schemas/RequestId'
        causes:
          type: array
          items:
            type: object
          description: Per-Item error breakdown for multi-Item requests.
        status:
          type: integer
          nullable: true
          description: HTTP status code (only present in webhook-delivered errors).
        documentation_url:
          type: string
          format: uri
        suggested_action:
          type: string
          nullable: true

    # ── ENUMS ─────────────────────────────────────────
    Products:
      type: string
      enum:
        - assets
        - auth
        - balance
        - employment
        - identity
        - identity_verification
        - income_verification
        - investments
        - liabilities
        - payment_initiation
        - signal
        - standing_orders
        - statements
        - transactions
        - transfer

    CountryCode:
      type: string
      enum: [US, GB, ES, NL, FR, IE, CA, DE, IT, PL, DK, NO, SE, EE, LT, LV, PT, BE]

    AccountType:
      type: string
      enum: [investment, credit, depository, loan, brokerage, other]

    AccountSubtype:
      type: string
      nullable: true
      enum:
        - 401a
        - 401k
        - 403B
        - 457b
        - 529
        - auto
        - brokerage
        - business
        - cash isa
        - cash management
        - cd
        - checking
        - commercial
        - construction
        - consumer
        - credit card
        - crypto exchange
        - ebt
        - education savings account
        - fixed annuity
        - gic
        - health reimbursement arrangement
        - home equity
        - hsa
        - isa
        - ira
        - keogh
        - lif
        - life insurance
        - line of credit
        - lira
        - loan
