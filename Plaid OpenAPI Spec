    # ── ACCOUNT ───────────────────────────────────────
    Account:
      type: object
      properties:
        account_id:
          type: string
          description: Plaid's unique identifier for the account.
        balances:
          $ref: '#/components/schemas/AccountBalance'
        mask:
          type: string
          nullable: true
          description: The last 2–4 digits of the account number.
        name:
          type: string
          description: The name of the account, as given by the institution.
        official_name:
          type: string
          nullable: true
          description: The official name of the account as given by the financial institution.
        type:
          $ref: '#/components/schemas/AccountType'
        subtype:
          $ref: '#/components/schemas/AccountSubtype'
        verification_status:
          type: string
          nullable: true
          enum:
            - automatically_verified
            - pending_automatic_verification
            - pending_manual_verification
            - manually_verified
            - verification_expired
            - verification_failed
            - database_matched
            - database_insights_pass
            - database_insights_pass_with_caution
            - database_insights_fail
        persistent_account_id:
          type: string
          nullable: true
          description: A stable, permanent identifier for the account that persists even if `account_id` changes.

    AccountBalance:
      type: object
      properties:
        available:
          type: number
          nullable: true
          description: |
            Funds available for immediate use. For credit accounts: credit limit minus current balance.
            For depository accounts: balance minus pending outflows.
        current:
          type: number
          nullable: true
          description: Total balance including pending transactions.
        limit:
          type: number
          nullable: true
          description: Credit limit (credit accounts only).
        iso_currency_code:
          type: string
          nullable: true
          description: ISO 4217 currency code of the balance (e.g. `USD`).
        unofficial_currency_code:
          type: string
          nullable: true
          description: Unofficial currency code for currencies not in ISO 4217.
        last_updated_datetime:
          type: string
          format: date-time
          nullable: true

    # ── ITEM ──────────────────────────────────────────
    Item:
      type: object
      properties:
        item_id:
          type: string
          description: Plaid's unique identifier for the Item.
        institution_id:
          type: string
          nullable: true
        institution_name:
          type: string
          nullable: true
        webhook:
          type: string
          nullable: true
          format: uri
        auth_method:
          type: string
          nullable: true
          enum:
            - INSTANT_AUTH
            - INSTANT_MATCH
            - AUTOMATED_MICRODEPOSITS
            - SAME_DAY_MICRODEPOSITS
            - INSTANT_MICRODEPOSITS
            - DATABASE_MATCH
            - DATABASE_INSIGHTS
            - TRANSFER_MIGRATED
            - INVESTMENTS_FALLBACK
        error:
          $ref: '#/components/schemas/PlaidError'
        available_products:
          type: array
          items:
            $ref: '#/components/schemas/Products'
        billed_products:
          type: array
          items:
            $ref: '#/components/schemas/Products'
        products:
          type: array
          items:
            $ref: '#/components/schemas/Products'
        consented_products:
          type: array
          items:
            $ref: '#/components/schemas/Products'
        consent_expiration_time:
          type: string
          format: date-time
          nullable: true
        update_type:
          type: string
          enum: [background, user_present_required]
        status:
          type: object
          nullable: true
          properties:
            investments:
              type: object
              nullable: true
              properties:
                last_successful_update:
                  type: string
                  format: date-time
                  nullable: true
                last_failed_update:
                  type: string
                  format: date-time
                  nullable: true
            transactions:
              type: object
              nullable: true
              properties:
                last_successful_update:
                  type: string
                  format: date-time
                  nullable: true
                last_failed_update:
                  type: string
                  format: date-time
                  nullable: true

    # ── TRANSACTION ───────────────────────────────────
    Transaction:
      type: object
      properties:
        transaction_id:
          type: string
        account_id:
          type: string
        amount:
          type: number
          description: |
            Positive = money leaving the account (debit). Negative = money entering (credit).
        iso_currency_code:
          type: string
          nullable: true
        unofficial_currency_code:
          type: string
          nullable: true
        date:
          type: string
          format: date
          description: Posted date (YYYY-MM-DD).
        authorized_date:
          type: string
          format: date
          nullable: true
          description: Date the transaction was authorized.
        authorized_datetime:
          type: string
          format: date-time
          nullable: true
        datetime:
          type: string
          format: date-time
          nullable: true
        name:
          type: string
          description: Merchant or transaction name.
        merchant_name:
          type: string
          nullable: true
        merchant_entity_id:
          type: string
          nullable: true
          description: A stable ID for the merchant that persists across transactions.
        original_description:
          type: string
          nullable: true
          description: Raw unparsed description from the institution (if requested).
        category:
          type: array
          nullable: true
          items:
            type: string
          description: Hierarchical category list (legacy; prefer `personal_finance_category`).
        category_id:
          type: string
          nullable: true
        personal_finance_category:
          type: object
          nullable: true
          properties:
            primary:
              type: string
            detailed:
              type: string
            confidence_level:
              type: string
              enum: [VERY_HIGH, HIGH, MEDIUM, LOW, UNKNOWN]
        personal_finance_category_icon_url:
          type: string
          nullable: true
          format: uri
        location:
          $ref: '#/components/schemas/TransactionLocation'
        payment_meta:
          $ref: '#/components/schemas/PaymentMeta'
        account_owner:
          type: string
          nullable: true
        pending:
          type: boolean
          description: True if the transaction has not yet settled.
        pending_transaction_id:
          type: string
          nullable: true
          description: The `transaction_id` of the pending transaction this settled from, if any.
        transaction_code:
          type: string
          nullable: true
        transaction_type:
          type: string
          nullable: true
          enum: [digital, place, special, unresolved]
        logo_url:
          type: string
          nullable: true
          format: uri
        website:
          type: string
          nullable: true
        check_number:
          type: string
          nullable: true
        counterparties:
          type: array
          items:
            type: object
            properties:
              name:
                type: string
              type:
                type: string
                enum: [merchant, financial_institution, tax_authority, individual, government, payment_app]
              logo_url:
                type: string
                nullable: true
                format: uri
              website:
                type: string
                nullable: true
              entity_id:
                type: string
                nullable: true
              confidence_level:
                type: string
                enum: [VERY_HIGH, HIGH, MEDIUM, LOW, UNKNOWN]

    TransactionLocation:
      type: object
      properties:
        address:
          type: string
          nullable: true
        city:
          type: string
          nullable: true
        region:
          type: string
          nullable: true
        postal_code:
          type: string
          nullable: true
        country:
          type: string
          nullable: true
        lat:
          type: number
          nullable: true
        lon:
          type: number
          nullable: true
        store_number:
          type: string
          nullable: true

    PaymentMeta:
      type: object
      properties:
        reference_number:
          type: string
          nullable: true
        ppd_id:
          type: string
          nullable: true
        payee:
          type: string
          nullable: true
        by_order_of:
          type: string
          nullable: true
        payer:
          type: string
          nullable: true
        payment_method:
          type: string
          nullable: true
        payment_processor:
          type: string
          nullable: true
        reason:
          type: string
          nullable: true

    # ── IDENTITY ──────────────────────────────────────
    Owner:
      type: object
      properties:
        names:
          type: array
          items:
            type: string
          description: Legal names on the account.
        phone_numbers:
          type: array
          items:
            $ref: '#/components/schemas/PhoneNumber'
        emails:
          type: array
          items:
            $ref: '#/components/schemas/Email'
        addresses:
          type: array
          items:
            $ref: '#/components/schemas/Address'

    PhoneNumber:
      type: object
      properties:
        data:
          type: string
        primary:
          type: boolean
        type:
          type: string
          enum: [home, work, office, mobile, mobile1, other]

    Email:
      type: object
      properties:
        data:
          type: string
          format: email
        primary:
          type: boolean
        type:
          type: string
          enum: [primary, secondary, other]

    Address:
      type: object
      properties:
        data:
          type: object
          properties:
            street:
              type: string
              nullable: true
            city:
              type: string
              nullable: true
            region:
              type: string
              nullable: true
            postal_code:
              type: string
              nullable: true
            country:
              type: string
              nullable: true
        primary:
          type: boolean

    # ── NUMBER (AUTH) ──────────────────────────────────
    NumbersACH:
      type: object
      properties:
        account_id:
          type: string
        account:
          type: string
          description: The full account number.
        routing:
          type: string
          description: ABA routing number.
        wire_routing:
          type: string
          nullable: true
          description: Wire routing number (may differ from ACH routing).

    NumbersEFT:
      type: object
      properties:
        account_id:
          type: string
        account:
          type: string
        institution:
          type: string
        branch:
          type: string

    NumbersInternational:
      type: object
      properties:
        account_id:
          type: string
        iban:
          type: string
          nullable: true
        bic:
          type: string
          nullable: true

    NumbersBACS:
      type: object
      properties:
        account_id:
          type: string
        account:
          type: string
        sort_code:
          type: string

    # ── INSTITUTION ───────────────────────────────────
    Institution:
      type: object
      properties:
        institution_id:
          type: string
        name:
          type: string
        products:
          type: array
          items:
            $ref: '#/components/schemas/Products'
        country_codes:
          type: array
          items:
            $ref: '#/components/schemas/CountryCode'
        url:
          type: string
          nullable: true
          format: uri
        primary_color:
          type: string
          nullable: true
        logo:
          type: string
          nullable: true
          description: Base64-encoded institution logo.
        routing_numbers:
          type: array
          items:
            type: string
        dtc_numbers:
          type: array
          items:
            type: string
        oauth:
          type: boolean
          description: Whether the institution uses OAuth for authentication.
        status:
          type: object
          nullable: true
        payment_initiation_metadata:
          type: object
          nullable: true

    InstitutionsGetRequestOptions:
      type: object
      properties:
        products:
          type: array
          items:
            $ref: '#/components/schemas/Products'
        routing_numbers:
          type: array
          items:
            type: string
        oauth:
          type: boolean
        include_auth_metadata:
          type: boolean
          default: false
        include_payment_initiation_metadata:
          type: boolean
          default: false

    # ── RECURRING TRANSACTION ─────────────────────────
    TransactionStream:
      type: object
      properties:
        account_id:
          type: string
        stream_id:
          type: string
        category:
          type: array
          items:
            type: string
        category_id:
          type: string
        description:
          type: string
        merchant_name:
          type: string
          nullable: true
        first_date:
          type: string
          format: date
        last_date:
          type: string
          format: date
        frequency:
          type: string
          enum: [WEEKLY, BIWEEKLY, SEMI_MONTHLY, MONTHLY, ANNUALLY, IRREGULAR, UNKNOWN]
        transaction_ids:
          type: array
          items:
            type: string
        average_amount:
          type: object
          properties:
            amount:
              type: number
            iso_currency_code:
              type: string
              nullable: true
        last_amount:
          type: object
          properties:
            amount:
              type: number
            iso_currency_code:
              type: string
              nullable: true
        is_active:
          type: boolean
        status:
          type: string
          enum: [MATURE, EARLY_DETECTION, TOMBSTONED, UNKNOWN]
        personal_finance_category:
          type: object
          nullable: true
          properties:
            primary:
              type: string
            detailed:
              type: string
            confidence_level:
              type: string

    # ── CATEGORY ──────────────────────────────────────
    Category:
      type: object
      properties:
        category_id:
          type: string
        group:
          type: string
          enum: [special, place, transfer, recreation, shops, food]
        hierarchy:
          type: array
          items:
            type: string
          description: Human-readable category hierarchy, e.g. ["Food and Drink", "Restaurants"].

    # ── REQUEST SCHEMAS ───────────────────────────────
    LinkTokenCreateRequest:
      type: object
      required: [user, client_name, language, country_codes]
      allOf:
        - $ref: '#/components/schemas/AuthFields'
      properties:
        user:
          type: object
          required: [client_user_id]
          properties:
            client_user_id:
              type: string
              description: Your unique identifier for the user. Used for token deduplication.
            legal_name:
              type: string
            name:
              type: object
              properties:
                given_name:
                  type: string
                family_name:
                  type: string
            phone_number:
              type: string
            phone_number_verified_time:
              type: string
              format: date-time
            email_address:
              type: string
              format: email
            email_address_verified_time:
              type: string
              format: date-time
            id_number:
              type: object
              properties:
                value:
                  type: string
                type:
                  type: string
                  enum: [ar_dni, au_drivers_license, au_passport, br_cpf, ca_sin, cl_run, cn_resident_card, co_nit, dk_cpr, eg_national_id, es_nif, et_medhanit, gb_nhs, hk_hkid, in_pan, it_cf, jo_civil, jp_my_number, ke_huduma_namba, kw_civil, mx_curp, mx_rfc, my_nric, ng_nin, nz_drivers_license, om_civil, ph_psn, pk_cnic, pl_pesel, ro_cnp, sa_national_id, se_pin, sg_nric, tr_tc_kimlik, us_ssn, us_ssn_last_4, za_smartid]
        client_name:
          type: string
          description: Display name shown on the Link consent pane.
        language:
          type: string
          description: Language for the Link UI (e.g. `en`).
        country_codes:
          type: array
          items:
            $ref: '#/components/schemas/CountryCode'
        products:
          type: array
          items:
            $ref: '#/components/schemas/Products'
        required_if_supported_products:
          type: array
          items:
            $ref: '#/components/schemas/Products'
        optional_products:
          type: array
          items:
            $ref: '#/components/schemas/Products'
        additional_consented_products:
          type: array
          items:
            $ref: '#/components/schemas/Products'
        webhook:
          type: string
          format: uri
        access_token:
          type: string
          description: Supply an existing `access_token` to launch Link in update mode.
        link_customization_name:
          type: string
        redirect_uri:
          type: string
          format: uri
          description: Required for OAuth institutions to redirect back to your app.
        android_package_name:
          type: string
        account_filters:
          type: object
          description: Pre-filter accounts by type presented in Link.
        institutions:
          type: array
          items:
            type: string
          description: Limit Link to specific institution IDs.
        auth:
          type: object
          properties:
            flow_type:
              type: string
              enum: [INSTANT_AUTH, INSTANT_MATCH, AUTOMATED_MICRODEPOSITS, SAME_DAY_MICRODEPOSITS, INSTANT_MICRODEPOSITS, DATABASE_MATCH, DATABASE_INSIGHTS]
            automated_microdeposits_enabled:
              type: boolean
            instant_microdeposits_enabled:
              type: boolean
            same_day_microdeposits_enabled:
              type: boolean
            database_match:
              type: object
        identity_verification:
          type: object
          properties:
            template_id:
              type: string
        user_token:
          type: string
          description: A user token to associate this Link session with a Plaid user.
        hosted_link:
          type: object
          properties:
            delivery_method:
              type: string
              enum: [SMS, URL]

    TransactionsSyncRequest:
      allOf:
        - $ref: '#/components/schemas/AuthFields'
        - $ref: '#/components/schemas/AccessTokenField'
        - type: object
          properties:
            cursor:
              type: string
              maxLength: 256
              description: |
                Pagination cursor from the previous response's `next_cursor`.
                Omit on first call to receive full history.
            count:
              type: integer
              minimum: 1
              maximum: 500
              default: 100
              description: Number of transaction updates to return.
            options:
              type: object
              properties:
                include_original_description:
                  type: boolean
                  default: false
                include_personal_finance_category:
                  type: boolean
                  default: false
                include_logo_and_counterparties:
                  type: boolean
                  default: false
                days_requested:
                  type: integer
                  minimum: 1
                  maximum: 730
                personal_finance_category_version:
                  type: string
                  enum: [v1, v2]

    TransactionsGetRequest:
      allOf:
        - $ref: '#/components/schemas/AuthFields'
        - $ref: '#/components/schemas/AccessTokenField'
        - type: object
          required: [start_date, end_date]
          properties:
            start_date:
              type: string
              format: date
              description: Start of the date range (YYYY-MM-DD). Up to 24 months back.
            end_date:
              type: string
              format: date
              description: End of the date range (YYYY-MM-DD). Cannot be a future date.
            options:
              type: object
              properties:
                account_ids:
                  type: array
                  items:
                    type: string
                count:
                  type: integer
                  minimum: 1
                  maximum: 500
                  default: 100
                offset:
                  type: integer
                  minimum: 0
                  default: 0
                include_original_description:
                  type: boolean
                  default: false
                include_personal_finance_category:
                  type: boolean
                  default: false
                include_logo_and_counterparties:
                  type: boolean
                  default: false
                days_requested:
                  type: integer
                personal_finance_category_version:
                  type: string
                  enum: [v1, v2]

    # ── RESPONSE SCHEMAS ──────────────────────────────
    LinkTokenCreateResponse:
      type: object
      properties:
        link_token:
          type: string
          description: A `link_token`, valid for 4 hours. Pass to the Plaid Link SDK.
        expiration:
          type: string
          format: date-time
          description: Expiry timestamp of the link token.
        request_id:
          $ref: '#/components/schemas/RequestId'

    LinkTokenGetResponse:
      type: object
      properties:
        link_token:
          type: string
        created_at:
          type: string
          format: date-time
          nullable: true
        expiration:
          type: string
          format: date-time
          nullable: true
        metadata:
          type: object
          properties:
            initial_products:
              type: array
              items:
                $ref: '#/components/schemas/Products'
            webhook:
              type: string
              nullable: true
              format: uri
            country_codes:
              type: array
              items:
                $ref: '#/components/schemas/CountryCode'
            language:
              type: string
              nullable: true
            account_filters:
              type: object
              nullable: true
            redirect_uri:
              type: string
              nullable: true
              format: uri
            client_name:
              type: string
        request_id:
          $ref: '#/components/schemas/RequestId'

    ItemGetResponse:
      type: object
      properties:
        item:
          $ref: '#/components/schemas/Item'
        status:
          type: object
          nullable: true
        request_id:
          $ref: '#/components/schemas/RequestId'

    ItemRemoveResponse:
      type: object
      properties:
        request_id:
          $ref: '#/components/schemas/RequestId'

    ItemWebhookUpdateResponse:
      type: object
      properties:
        item:
          $ref: '#/components/schemas/Item'
        request_id:
          $ref: '#/components/schemas/RequestId'

    ItemPublicTokenExchangeResponse:
      type: object
      properties:
        access_token:
          type: string
          description: The long-lived access token for the Item.
        item_id:
          type: string
        request_id:
          $ref: '#/components/schemas/RequestId'

    AccountsGetResponse:
      type: object
      properties:
        accounts:
          type: array
          items:
            $ref: '#/components/schemas/Account'
        item:
          $ref: '#/components/schemas/Item'
        request_id:
          $ref: '#/components/schemas/RequestId'

    TransactionsSyncResponse:
      type: object
      properties:
        added:
          type: array
          items:
            $ref: '#/components/schemas/Transaction'
          description: New transactions since the cursor.
        modified:
          type: array
          items:
            $ref: '#/components/schemas/Transaction'
          description: Transactions that have been updated.
        removed:
          type: array
          items:
            type: object
            properties:
              transaction_id:
                type: string
          description: Transactions that have been removed.
        next_cursor:
          type: string
          description: Cursor for the next sync call. Store and reuse.
        has_more:
          type: boolean
          description: If true, call `/transactions/sync` again with `next_cursor` to fetch remaining updates.
        request_id:
          $ref: '#/components/schemas/RequestId'

    TransactionsGetResponse:
      type: object
      properties:
        accounts:
          type: array
          items:
            $ref: '#/components/schemas/Account'
        transactions:
          type: array
          items:
            $ref: '#/components/schemas/Transaction'
        total_transactions:
          type: integer
          description: Total number of transactions available for the date range (for pagination).
        item:
          $ref: '#/components/schemas/Item'
        request_id:
          $ref: '#/components/schemas/RequestId'

    TransactionsRecurringGetResponse:
      type: object
      properties:
        inflow_streams:
          type: array
          items:
            $ref: '#/components/schemas/TransactionStream'
          description: Recurring inflows (e.g. salary, dividends).
        outflow_streams:
          type: array
          items:
            $ref: '#/components/schemas/TransactionStream'
          description: Recurring outflows (e.g. subscriptions, rent).
        updated_datetime:
          type: string
          format: date-time
        request_id:
          $ref: '#/components/schemas/RequestId'

    AuthGetResponse:
      type: object
      properties:
        accounts:
          type: array
          items:
            $ref: '#/components/schemas/Account'
        numbers:
          type: object
          properties:
            ach:
              type: array
              items:
                $ref: '#/components/schemas/NumbersACH'
            eft:
              type: array
              items:
                $ref: '#/components/schemas/NumbersEFT'
            international:
              type: array
              items:
                $ref: '#/components/schemas/NumbersInternational'
            bacs:
              type: array
              items:
                $ref: '#/components/schemas/NumbersBACS'
        item:
          $ref: '#/components/schemas/Item'
        request_id:
          $ref: '#/components/schemas/RequestId'

    IdentityGetResponse:
      type: object
      properties:
        accounts:
          type: array
          items:
