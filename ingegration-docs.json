{"openapi":"3.0.0","paths":{"/api/integrations/jobs":{"post":{"operationId":"IntegrationsController_createJob","summary":"Create or upsert a job (ATS/VMS → Hoonr)","parameters":[],"requestBody":{"required":true,"content":{"application/json":{"schema":{"$ref":"#/components/schemas/CreateIntegrationJobDto"}}}},"responses":{"201":{"description":""}},"tags":["integrations"],"security":[{"x-tenant":[]},{"x-service":[]},{"token":[]}]},"get":{"operationId":"IntegrationsController_listJobs","summary":"List jobs for outbound ATS sync (supports updatedSince, search, page)","parameters":[{"name":"updatedSince","required":false,"in":"query","description":"ISO date — only jobs with updatedAt >= this value","example":"2026-01-01T00:00:00.000Z","schema":{"type":"string"}},{"name":"search","required":false,"in":"query","description":"Match jobTitle, clientName, or numeric Hoonr id","example":"Software Engineer","schema":{"type":"string"}},{"name":"page","required":false,"in":"query","description":"1-based page (20 per page)","example":"1","schema":{"type":"string"}}],"responses":{"200":{"description":""}},"tags":["integrations"],"security":[{"x-tenant":[]},{"x-service":[]},{"token":[]}]}},"/api/integrations/jobs/{id}":{"patch":{"operationId":"IntegrationsController_updateJob","summary":"Update a job by Hoonr id (ATS/VMS → Hoonr)","parameters":[{"name":"id","required":true,"in":"path","schema":{"type":"number"}}],"requestBody":{"required":true,"content":{"application/json":{"schema":{"$ref":"#/components/schemas/UpdateIntegrationJobDto"}}}},"responses":{"200":{"description":""}},"tags":["integrations"],"security":[{"x-tenant":[]},{"x-service":[]},{"token":[]}]},"get":{"operationId":"IntegrationsController_getJob","summary":"Get a job by Hoonr id (outbound ATS sync)","parameters":[{"name":"id","required":true,"in":"path","schema":{"type":"number"}}],"responses":{"200":{"description":""}},"tags":["integrations"],"security":[{"x-tenant":[]},{"x-service":[]},{"token":[]}]}},"/api/integrations/candidates/search":{"get":{"operationId":"IntegrationsController_searchCandidatesGet","summary":"Search candidates in Hoonr (for ATS enrichment)","parameters":[{"name":"page","required":false,"in":"query","description":"1-based page (20 per page)","example":"1","schema":{"type":"string"}},{"name":"queryData","required":false,"in":"query","description":"Free-text search (name, email, phone, boolean skill queries). Preferred for ATS enrichment by email/name.","example":"jane.doe@example.com","schema":{"type":"string"}},{"name":"skills","required":false,"in":"query","description":"Skill category filter (matches skills.skillCategory)","example":"Cloud","schema":{"type":"string"}},{"name":"skillFinal","required":false,"in":"query","description":"Exact skill name (e.g. AWS). Prefer over skills for specific skills.","example":"AWS","schema":{"type":"string"}},{"name":"country","required":false,"in":"query","schema":{"type":"string"}},{"name":"state","required":false,"in":"query","schema":{"type":"string"}},{"name":"city","required":false,"in":"query","schema":{"type":"string"}},{"name":"experience_level","required":false,"in":"query","example":"Senior","schema":{"type":"string"}},{"name":"domain","required":false,"in":"query","schema":{"type":"string"}},{"name":"roleType","required":false,"in":"query","schema":{"type":"string"}},{"name":"status","required":false,"in":"query","description":"Candidate status filter","schema":{"type":"string"}},{"name":"addedWith","required":false,"in":"query","description":"How the candidate was added (e.g. Join-hoonr)","schema":{"type":"string"}}],"responses":{"200":{"description":""}},"tags":["integrations"],"security":[{"x-tenant":[]},{"x-service":[]},{"token":[]}]},"post":{"operationId":"IntegrationsController_searchCandidatesPost","summary":"Search candidates in Hoonr (POST body filters as query map)","parameters":[],"requestBody":{"required":true,"content":{"application/json":{"schema":{"$ref":"#/components/schemas/SearchIntegrationCandidatesDto"}}}},"responses":{"201":{"description":""}},"tags":["integrations"],"security":[{"x-tenant":[]},{"x-service":[]},{"token":[]}]}},"/api/integrations/candidates/{id}/notes":{"get":{"operationId":"IntegrationsController_getCandidateNotes","summary":"List candidate notes (Hoonr → ATS pull; optional createdSince)","parameters":[{"name":"id","required":true,"in":"path","schema":{"type":"number"}},{"name":"createdSince","required":false,"in":"query","description":"ISO date — only notes with createdAt >= this value","example":"2026-01-01T00:00:00.000Z","schema":{"type":"string"}}],"responses":{"200":{"description":""}},"tags":["integrations"],"security":[{"x-tenant":[]},{"x-service":[]},{"token":[]}]}},"/api/integrations/submissions":{"get":{"operationId":"IntegrationsController_listSubmissions","summary":"List submissions pending outbound push to VMS (default status=CREATED)","parameters":[{"name":"status","required":false,"in":"query","description":"Defaults to CREATED when omitted","example":"CREATED","schema":{"enum":["CREATED","SUBMITTING","SUBMITTED","SUBMISSION_FAILED"],"type":"string"}},{"name":"page","required":false,"in":"query","description":"1-based page","example":"1","schema":{"type":"string"}}],"responses":{"200":{"description":""}},"tags":["integrations"],"security":[{"x-tenant":[]},{"x-service":[]},{"token":[]}]}},"/api/integrations/submissions/{id}/ack":{"post":{"operationId":"IntegrationsController_acknowledgeSubmission","summary":"Acknowledge a submission was pulled for VMS push (CREATED → SUBMITTING)","parameters":[{"name":"id","required":true,"in":"path","schema":{"type":"number"}}],"responses":{"201":{"description":""}},"tags":["integrations"],"security":[{"x-tenant":[]},{"x-service":[]},{"token":[]}]}},"/api/integrations/submissions/status":{"post":{"operationId":"IntegrationsController_updateSubmissionStatus","summary":"Update submission status from VMS (VMS → Hoonr)","parameters":[],"requestBody":{"required":true,"content":{"application/json":{"schema":{"$ref":"#/components/schemas/IntegrationSubmissionStatusDto"}}}},"responses":{"201":{"description":""}},"tags":["integrations"],"security":[{"x-tenant":[]},{"x-service":[]},{"token":[]}]}}},"info":{"title":"Hoonr Integrations API","description":"M2M ATS/VMS APIs. Auth: POST /auth/service-login on auth-backend, then Authorize with JWT, x-service: refold, x-tenant: <subDomain>.","version":"1.0","contact":{}},"tags":[],"servers":[],"components":{"securitySchemes":{"token":{"scheme":"bearer","bearerFormat":"JWT","type":"http","description":"JWT from auth-backend POST /auth/service-login"},"x-service":{"type":"apiKey","in":"header","name":"x-service","description":"refold"},"x-tenant":{"type":"apiKey","in":"header","name":"x-tenant","description":"Tenant subdomain"}},"schemas":{"CreateIntegrationJobDto":{"type":"object","properties":{"jobTitle":{"type":"string","example":"Senior Software Engineer"},"jobDescription":{"type":"string","example":"Job description text"},"jobDescriptionHtml":{"type":"string"},"jobId":{"type":"string","description":"External ATS/VMS job id (idempotency key). Reused on upsert."},"recruiterId":{"type":"number","description":"Hoonr recruiter user id. Falls back to first tenant admin if omitted."},"assignedToUserId":{"type":"number"},"city":{"type":"string"},"state":{"type":"string"},"country":{"type":"string"},"skills":{"type":"array","items":{"type":"string"}},"otherSkills":{"type":"array","items":{"type":"string"}},"experienceLevel":{"type":"string"},"minExperience":{"type":"number"},"maxExperience":{"type":"number"},"jobType":{"type":"string"},"source":{"type":"string","example":"integration"},"clientName":{"type":"string"},"jobStatus":{"type":"string"},"postedDate":{"type":"string"},"hiringManagerName":{"type":"string"},"hiringManagerEmail":{"type":"string"},"hiringManagerMobile":{"type":"string"},"timezone":{"type":"string"}},"required":["jobTitle","jobDescription"]},"UpdateIntegrationJobDto":{"type":"object","properties":{"jobTitle":{"type":"string"},"jobDescription":{"type":"string"},"jobDescriptionHtml":{"type":"string"},"jobType":{"type":"string"},"clientName":{"type":"string"},"city":{"type":"string"},"state":{"type":"string"},"country":{"type":"string"},"skills":{"type":"array","items":{"type":"string"}},"otherSkills":{"type":"array","items":{"type":"string"}},"experienceLevel":{"type":"string"},"jobStatus":{"type":"string"},"hiringManagerName":{"type":"string"},"hiringManagerEmail":{"type":"string"},"hiringManagerMobile":{"type":"string"},"assignedToUserId":{"type":"number"},"timezone":{"type":"string"}}},"SearchIntegrationCandidatesDto":{"type":"object","properties":{"page":{"type":"string","description":"1-based page (20 per page)","example":"1"},"queryData":{"type":"string","description":"Free-text search (name, email, phone, boolean skill queries). Preferred for ATS enrichment by email/name.","example":"jane.doe@example.com"},"skills":{"type":"string","description":"Skill category filter (matches skills.skillCategory)","example":"Cloud"},"skillFinal":{"type":"string","description":"Exact skill name (e.g. AWS). Prefer over skills for specific skills.","example":"AWS"},"country":{"type":"string"},"state":{"type":"string"},"city":{"type":"string"},"experience_level":{"type":"string","example":"Senior"},"domain":{"type":"string"},"roleType":{"type":"string"},"status":{"type":"string","description":"Candidate status filter"},"addedWith":{"type":"string","description":"How the candidate was added (e.g. Join-hoonr)"}}},"IntegrationSubmissionStatusDto":{"type":"object","properties":{"submissionId":{"type":"number","example":42,"description":"Hoonr CandidateSubmission primary id"},"status":{"type":"string","enum":["CREATED","SUBMITTING","SUBMITTED","SUBMISSION_FAILED"],"example":"SUBMITTED"},"failureReason":{"type":"string","description":"Required when status is SUBMISSION_FAILED"}},"required":["submissionId","status"]},"ListIntegrationJobsQueryDto":{"type":"object","properties":{"updatedSince":{"type":"string","description":"ISO date — only jobs with updatedAt >= this value","example":"2026-01-01T00:00:00.000Z"},"search":{"type":"string","description":"Match jobTitle, clientName, or numeric Hoonr id","example":"Software Engineer"},"page":{"type":"string","description":"1-based page (20 per page)","example":"1"}}},"ListIntegrationCandidateNotesQueryDto":{"type":"object","properties":{"createdSince":{"type":"string","description":"ISO date — only notes with createdAt >= this value","example":"2026-01-01T00:00:00.000Z"}}},"ListIntegrationSubmissionsQueryDto":{"type":"object","properties":{"status":{"type":"string","enum":["CREATED","SUBMITTING","SUBMITTED","SUBMISSION_FAILED"],"description":"Defaults to CREATED when omitted","example":"CREATED"},"page":{"type":"string","description":"1-based page","example":"1"}}}}},"externalDocs":{"description":"OpenAPI JSON","url":"/integrations-docs-json"}}
